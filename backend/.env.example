PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillproof
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Repository scan budgets (bytes). A 10 MiB file can be included when the
# snapshot budget is also large enough; keep these limits bounded.
REPO_MAX_FILES=120
REPO_MAX_FILE_BYTES=1048576
REPO_MAX_SNAPSHOT_BYTES=12582912
# Gemini receives only extracted evidence, never the complete repository snapshot.
AI_EVIDENCE_MAX_FILES=6
AI_EVIDENCE_SNIPPET_CHARS=1200
AI_CONTEXT_MAX_CHARS=12000
NODE_ENV=development
WATCHER_ENABLED=true
FRONTEND_URL=http://localhost:5173
